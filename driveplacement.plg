<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "driveplacement">
<!ENTITY author "hernandito">
<!ENTITY version "2026.11.11">
<!ENTITY github "hernandito/Drive.Placement">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
<!ENTITY plugdir "/usr/local/emhttp/plugins/&name;">
<!ENTITY cache "/boot/config/plugins/&name;/&version;">
<!ENTITY src "https://raw.githubusercontent.com/&github;/main">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="/Settings/DrivePlacement"
        pluginURL="&pluginURL;"
        support="https://github.com/&github;"
        min="6.12.0">

<CHANGES>

###2026.11.11
- Installs without internet: plugin files are kept on the flash drive, so the plugin loads at boot even when GitHub can't be reached.
- Updates now take effect immediately, without a reboot.

###2026.11.09
- New Ultra-Compact view: a one-line-per-drive density (name - size [serial] [badge]), chosen from a Standard / Compact / Ultra-Compact selector in the toolbar.
- Usage bar moved to its own full-width line below the drive name, ending with a "Free: x.xx TB - nn%" readout.
- Category badge (Array, Parity, Pool, UD, Flash) pinned to the card's top-right; the divider now sits below the usage bar.
- Compact cards grow to fit the new usage line; size-icon and format-label spacing polish.

###2026.11.06
- Filesystem format shown on every card (xfs, btrfs, zfs, ntfs, fat, exfat ...).
- Unassigned Devices now show temperature, usage, and free space like array/pool drives; unmounted devices are flagged "Not mounted".
- Multi-partition UD drives list each partition (name, format, usage) below the card.
- Identify button: blinks a drive's activity LED (read-only) to find it in the bay.
- Non-compact cards now match the compact card width (they grow taller, not wider).
- Smaller, squarer identify button; card and header styling polish.

###2026.11.05
- Major update. Redesigned drive cards: temperature pill, usage bar with free-space value, spun-down indicator, and in-flow type badge on a single top line.
- Health awareness: drives with an issue are highlighted with a red card.
- New categories: Pool (cache) and Flash are now distinct from Unassigned (UD).
- Category background colors: assign a background color per category (Array, Parity, Pool, UD, Flash) via a color modal, plus a per-card color override. Ships with sensible default tints.
- Dark skin support: automatically matches unRAID black/gray themes.
- Per-column auto width (sizes to the widest card), cache-busted assets, and an Export PDF option.

###2026.04.04
- Notes icon in Compact Mode. CSS tweaks.

###2026.04.03a
- Added compact mode.

###2026.04.03
- Added per drive notes.

###2026.04.01b
- Changed to color icon in Settings Page.

###2026.04.01b
- Add custom icon, and unRAID's Plugin's page page description.

###2026.04.01a
- Initial release: Interactive drag-and-drop drive placement dashboard.


</CHANGES>

<!--
  OFFLINE-SAFE INSTALL
  Unraid re-runs this file at EVERY boot. Each file below is saved on the flash
  drive in a folder named after the version (&cache;). Unraid skips a download
  when the file already exists, so after the first install a boot needs no
  internet. A new version uses a new folder, so updates always get fresh files.
  The files are then copied into the RAM plugin folder by the script further down.
-->
<FILE Name="&cache;/DrivePlacement.page"><URL>&src;/DrivePlacement.page</URL></FILE>
<FILE Name="&cache;/DrivePlacement.php"><URL>&src;/DrivePlacement.php</URL></FILE>
<FILE Name="&cache;/DrivePlacement.css"><URL>&src;/DrivePlacement.css</URL></FILE>
<FILE Name="&cache;/DrivePlacement.js"><URL>&src;/DrivePlacement.js</URL></FILE>
<FILE Name="&cache;/save.php"><URL>&src;/save.php</URL></FILE>
<FILE Name="&cache;/identify.php"><URL>&src;/identify.php</URL></FILE>
<FILE Name="&cache;/icons/hdd.png"><URL>&src;/icons/hdd.png</URL></FILE>
<FILE Name="&cache;/icons/ssd.png"><URL>&src;/icons/ssd.png</URL></FILE>
<FILE Name="&cache;/icons/nvme.png"><URL>&src;/icons/nvme.png</URL></FILE>
<FILE Name="&cache;/icons/usb.png"><URL>&src;/icons/usb.png</URL></FILE>
<FILE Name="&cache;/README.md"><URL>&src;/description.txt</URL></FILE>
<FILE Name="&cache;/&name;.png"><URL>&src;/icon.png</URL></FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NAME="driveplacement"
VERSION="]]>&version;<![CDATA["
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"
CACHE="$CONF/$VERSION"

# Lay down a clean copy of this version from the flash cache
rm -rf "$PLUGDIR"
mkdir -p "$PLUGDIR"
cp -r "$CACHE"/. "$PLUGDIR"/

# Remove cached files from older versions (keeps layout.json and other settings)
for d in "$CONF"/*/; do
  v=$(basename "$d")
  case "$v" in
    20[0-9][0-9].[0-9][0-9].[0-9][0-9]*) [ "$v" != "$VERSION" ] && rm -rf "$d" ;;
  esac
done

chown -R root:root "$PLUGDIR"
chmod -R 755 "$PLUGDIR"

echo ""
echo "----------------------------------------------------"
echo " Drive Placement has been installed."
echo " Version: $VERSION"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
NAME="driveplacement"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"

# Remove plugin files and the cached copies, but keep the user's layout
rm -rf "$PLUGDIR"
for d in "$CONF"/20[0-9][0-9].[0-9][0-9].[0-9][0-9]*/; do [ -d "$d" ] && rm -rf "$d"; done

echo ""
echo "----------------------------------------------------------------------------"
echo " Drive Placement has been uninstalled."
echo " Persistent layout in /boot/config/plugins/driveplacement was preserved."
echo "----------------------------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>
</PLUGIN>
