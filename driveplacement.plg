  <URL>https://raw.githubusercontent.com/&github;/main/DrivePlacement.page</URL>
</FILE>

<FILE Name="&plugdir;/DrivePlacement.php">
  <URL>https://raw.githubusercontent.com/&github;/main/DrivePlacement.php</URL>
</FILE>

