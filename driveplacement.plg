<FILE Name="&cache;/DrivePlacementDash.js"><URL>&src;/DrivePlacementDash.js</URL><MD5>54186d07da7ef5697712cc8335174d87</MD5></FILE>
<FILE Name="&cache;/set-dash.php"><URL>&src;/set-dash.php</URL><MD5>3cb6953b32eb75a2cfdcd24d45b93856</MD5></FILE>
<FILE Name="&cache;/save.php"><URL>&src;/save.php</URL><MD5>540fd64556c146176abdbba9170a6811</MD5></FILE>
<FILE Name="&cache;/identify.php"><URL>&src;/identify.php</URL><MD5>e54a34f1ae0212c4484a14759fbbb8d5</MD5></FILE>
<FILE Name="&cache;/icons/hdd.png"><URL>&src;/icons/hdd.png</URL><MD5>e2b3693ba5490ebd61266ad4e9dadf93</MD5></FILE>
<FILE Name="&cache;/icons/ssd.png"><URL>&src;/icons/ssd.png</URL><MD5>0cc29b68945714dabcdbc67d8613a727</MD5></FILE>
